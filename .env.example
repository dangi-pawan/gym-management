# Copy to .env for local development. Keep real secrets out of Git.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://gym_app:replace-me@localhost:5432/gym_management
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CSRF_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_MAX_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=50
LOGIN_RATE_LIMIT_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_IP_MAX_REQUESTS=20
PASSWORD_RESET_RATE_LIMIT_MINUTES=60
EMPLOYEE_INVITATION_MAX_PER_HOUR=20

ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
CSRF_TOKEN_COOKIE_NAME=csrf_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
CORS_ORIGINS=[]

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Local private storage for development. Production requires S3-compatible storage.
MEMBERSHIP_DOCUMENTS_DIR=.private/membership-documents
MEMBERSHIP_S3_BUCKET=
MEMBERSHIP_S3_REGION=ap-south-1
MEMBERSHIP_S3_ENDPOINT_URL=
MEMBERSHIP_S3_ACCESS_KEY_ID=
MEMBERSHIP_S3_SECRET_ACCESS_KEY=
MEMBERSHIP_S3_PREFIX=membership-documents
MEMBERSHIP_S3_PRESIGNED_URL_SECONDS=300

# Razorpay test/live credentials; never commit actual secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# Tax is configured per organization; zero means no GST is added.
MEMBERSHIP_DEFAULT_GST_RATE=0.00
